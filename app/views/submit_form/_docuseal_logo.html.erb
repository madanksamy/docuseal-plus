<a href="<%= root_path %>" class="mx-auto text-2xl md:text-3xl font-bold items-center flex space-x-3">
  <% logo_account = local_assigns[:account] || @submitter&.account || (defined?(current_account) ? current_account : nil) %>
  <% if logo_account&.logo&.attached? %>
    <%= image_tag(logo_account.logo, class: 'h-9 md:h-12 w-auto', alt: logo_account.name) %>
  <% else %>
    <%= render 'shared/logo', class: 'w-9 h-9 md:w-12 md:h-12' %>
    <span><%= Docuseal.product_name %></span>
  <% end %>
</a>
